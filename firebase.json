{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dist/**",
      "scripts/**",
      "schema/**",
      "Engineering/**",
      "teva/**",
      "tapi-chemistry/**",
      "**/*.bat",
      "**/*.cmd",
      "**/*.exe",
      "**/*.py",
      "**/*.7z",
      "**/*.zip",
      "**/*.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ]
  }
}
