{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dist/**",
      "scripts/**",
      "schema/**",
      "Engineering/**",
      "teva/**",
      "tapi-chemistry/**",
      "**/*.bat",
      "**/*.cmd",
      "**/*.exe",
      "**/*.py",
      "**/*.7z",
      "**/*.zip",
      "**/*.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/teva-engineering/:path*",
        "destination": "/tapi-engineering/:path*",
        "type": 301
      },
      {
        "source": "/teva-engineering",
        "destination": "/tapi-engineering/",
        "type": 301
      },
      {
        "source": "/teva-it/:path*",
        "destination": "/tapi-it/:path*",
        "type": 301
      },
      {
        "source": "/teva-it",
        "destination": "/tapi-it/",
        "type": 301
      }
    ]
  }
}