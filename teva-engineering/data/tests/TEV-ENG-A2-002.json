          "text": "showing"
        },
        {
          "key": "D",
          "text": "is show"
        }
      ],
      "correct_key": "B",
      "explanations": {
        "correct": "Singular subject 'sensor' takes 'shows' with 3rd person -s.",
        "wrong_A": "Lacks singular -s.",
        "wrong_C": "Participle alone cannot be verb.",
        "wrong_D": "Ungrammatical."
      },
      "cz_learning_point": "Czech 'Senzor ukazuje'. Singular subject takes '-s': 'shows'.",
